# /etc/nginx/sites-available/postiz
# Serves post.sugimotogroup.org only. Does not touch the Odoo server block.
server {
    listen 80;
    listen [::]:80;
    server_name post.sugimotogroup.org;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name post.sugimotogroup.org;

    ssl_certificate     /etc/letsencrypt/live/post.sugimotogroup.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/post.sugimotogroup.org/privkey.pem;

    # Video uploads are large and slow; Postiz accepts up to 2G internally.
    client_max_body_size 2G;
    proxy_read_timeout  1800s;
    proxy_send_timeout  1800s;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
