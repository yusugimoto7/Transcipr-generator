# --- Required ---
# OpenAI API key (server-side only, never shipped to the browser).
OPENAI_API_KEY=

# Email address(es) that are always ADMIN (comma-separated). Register with this
# email and you get the Admin console: create account managers, assign files.
ADMIN_EMAIL=

# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# --- Optional ---
# GPT model used for extraction/review/drafting. Must support image input (the
# page-orientation check) and PDF input (reading uploaded documents).
OPENAI_MODEL=gpt-4.1

# Only for Azure OpenAI, an API gateway, or an OpenAI-compatible proxy.
# Leave blank to use api.openai.com.
# OPENAI_BASE_URL=

# Import from Google Drive (staff only). A Google Cloud service-account key:
# the whole JSON file contents, or that JSON base64-encoded. Share the client
# folders with the service account's email as Viewer. See README.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_MAX_FILE_MB=25
# DRIVE_MAX_TOTAL_MB=400
# DRIVE_MAX_FILES=300

# Second, independent model for the document check (see README). With an
# Anthropic key set, Claude re-checks every document alongside GPT.
# ANTHROPIC_API_KEY=
# SECOND_MODEL=anthropic:claude-sonnet-5

# Email intake: the team mailbox clients send documents to (IMAP). IONOS defaults.
# MAIL_USER=visa@sugimotovisa.com
# MAIL_PASSWORD=
# MAIL_IMAP_HOST=imap.ionos.com
# MAIL_IMAP_PORT=993
# MAIL_POLL_MINUTES=5
# MAIL_SINCE_DAYS=7
# The address shown to clients under Add documents → By email (build-time setting).
# NEXT_PUBLIC_INTAKE_EMAIL=visa@sugimotovisa.com
# The Drive folder holding the client folders ("S26160 - First Last"); share it
# with the service account as Editor so emailed documents can be filed there.
# DRIVE_CLIENTS_FOLDER=https://drive.google.com/drive/folders/...
# Drive is where every file is kept; the server disk is only a cache (README → "Where files are kept").
# CACHE_MAX_MB=600
# CACHE_IDLE_MINUTES=30
# DRIVE_SYNC_MINUTES=10

# Odoo: read the TR Visa project's cards (client number + name; new cards → files). README → "Odoo".
# ODOO_URL=https://yourcompany.odoo.com
# ODOO_DB=yourcompany
# ODOO_USER=you@sugimotovisa.com
# ODOO_API_KEY=
# ODOO_PROJECT=Visa - TR

# Where runtime data and uploads are stored (defaults shown).
DATA_DIR=./data
UPLOAD_DIR=./uploads

# --- Representative / firm details (optional) ---
# Used in the RCIC Submission Letter signature. Defaults to Sugimoto Visa Inc.
# Override any of these to reuse the platform for another consultant.
# RCIC_NAME=Yu Hamed Sugimoto Chavoshi
# RCIC_NUMBER=R713046
# FIRM_NAME=Sugimoto Visa Inc.
# FIRM_PHONE=+1-604-781-0482
# FIRM_EMAIL=hamed@sugimotovisa.com
# FIRM_ADDRESS=501 - 3292 Production Way, Burnaby, Greater Vancouver, BC V5A 4R4
# FIRM_OFFICE_PHONE=+1 (604) 415-4792
# FIRM_OFFICE_EMAIL=info@sugimotovisa.com
# FIRM_WEBSITE=www.sugimotovisa.com
