# ---------------------------------------------------------------------------
# Trello -> Odoo migration credentials.
# Copy to .env in this directory and fill in. .env is git-ignored.
# ---------------------------------------------------------------------------

# Trello API key + token.
#   1. Open https://trello.com/power-ups/admin and create a Power-Up (any name).
#   2. Open its "API key" tab -> copy the API key below.
#   3. On that same page click "Token" (or visit the URL printed by
#      `python migrate.py auth-url`) and approve read access -> copy the token.
# The token must belong to an account that can see all 5 boards.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Odoo instance + credentials.
# ODOO_DB is the database name. If you do not know it, run
# `python migrate.py probe` — it lists the databases the server exposes, and
# for a one-database instance it is usually the subdomain ("odoo").
ODOO_URL=https://odoo.sugimotogroup.org
ODOO_DB=
ODOO_USERNAME=
# An API key is safer than a password: Odoo -> your avatar -> My Profile ->
# Account Security -> New API Key. Paste it here as the password.
ODOO_PASSWORD=
