# Anthropic API key — used server-side only (never exposed to the browser).
# Get one at https://console.anthropic.com
# Keep this set even when using OpenAI: it's the automatic fallback if an
# OpenAI call fails, so the app never breaks.
ANTHROPIC_API_KEY=

# OpenAI (optional) — switch topics + scripts to OpenAI models to cut cost.
# - Set USE_OPENAI=true to turn it on (leave unset/blank to stay on Claude).
# - OPENAI_API_KEY from https://platform.openai.com
# - Model IDs are overridable; see the per-job defaults below. Confirm the
#   exact IDs in your OpenAI dashboard before changing them.
USE_OPENAI=
OPENAI_API_KEY=
# Model per job. Defaults spend where quality is permanent (blog articles live
# on the site forever) and save where the work is mechanical rewriting.
# Approx cost in this app: article ~8.6c, script ~1.5c, topic refresh ~0.5c.
OPENAI_ARTICLE_MODEL=gpt-5.6-sol
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_REWRITE_MODEL=gpt-5.6-luna
# Only used if every RSS feed fails and the app falls back to LLM web search.
OPENAI_TOPICS_MODEL=gpt-4o-mini-search-preview
# Output ceiling for articles; raise if a reasoning model ever truncates.
OPENAI_ARTICLE_MAX_TOKENS=16000

# Extra topic sources (all optional, comma-separated, no code change needed).
# NEWS_FEED_URLS   — any RSS/Atom URL.
# X_FEED_URLS      — X/Twitter accounts as RSS (e.g. an rss.app bridge URL).
# YOUTUBE_FEED_URLS— ANY YouTube URL: a video link, an @handle, or a channel
#                    page. The channel is resolved to its RSS feed at runtime,
#                    so there is no channel ID to look up. Four channels are
#                    already built in; these are added on top.
# Check what is actually working at /api/feeds.
NEWS_FEED_URLS=
X_FEED_URLS=
YOUTUBE_FEED_URLS=

# WordPress (optional) — enables the "Generate blog article" + "Publish draft"
# feature that posts a Farsi SEO article to your site's Blog as a DRAFT.
# WP_APP_PASSWORD is a WordPress *Application Password* (WP Admin -> Users ->
# your profile -> Application Passwords), NOT your login password.
WP_BASE_URL=https://sugimotovisa.com
WP_USER=
WP_APP_PASSWORD=

# Google Sheet (optional) — permanent, cross-device "seen" memory, a history log
# of every topic shown, the Library of every generated script + article (so
# approved content is reusable from any device), AND the "Make Google Doc"
# button (turns a generated article into a Google Doc in your Drive — needs the
# Advanced Drive Service enabled in the Apps Script). If unset, the app keeps the
# Library in per-device browser storage instead. Setup steps are in
# google-apps-script.gs (re-deploy the web app after updating it).
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# Telegram (optional) — approved posts are sent automatically.
# 1. Create a bot with @BotFather -> it gives you the token below.
# 2. Add the bot as an ADMIN (with "Post messages") to your channel(s).
# 3. Find a channel's numeric id by posting in it, then opening
#    /api/telegram/updates. Debug wiring at /api/telegram.
TELEGRAM_BOT_TOKEN=
# Direct mode: on approve, the script is posted straight to this channel.
TELEGRAM_CHANNEL_ID=
#
# --- Approval mode (optional) --- if BOTH of the next two are set, the direct
# post above is replaced by a review step: the script is sent to the REVIEW chat
# with ✅/❌ buttons, and only publishes to the PUBLIC channel when you tap ✅.
# After setting these, open /api/telegram/setup ONCE to register the webhook.
TELEGRAM_REVIEW_CHAT_ID=
TELEGRAM_PUBLIC_CHANNEL_ID=
# A random string; Telegram echoes it back so the webhook can verify calls.
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# CANADA DRAWS AUTO-POSTER  (/api/draws/run — see README "Draw auto-poster")
# ─────────────────────────────────────────────────────────────────────────────
# Posts every new Express Entry / BC PNP / OINP / Alberta draw to Telegram, X,
# LinkedIn and Instagram, and optionally refreshes the WordPress draws page.
# Every channel is independent: leave a block blank and that channel is skipped.

# Shared secret protecting the worker endpoint. Required.
# Any long random string. Calls must pass it as ?key=<this value>
DRAWS_CRON_SECRET=

# Let the app schedule itself — no cron job to create anywhere. Set to "true"
# and it runs a cycle every DRAWS_INTERVAL_MINUTES (default 15) for as long as
# the service is up. Use a single instance; if you scale out, leave this off and
# point an external cron at /api/draws/run instead.
DRAWS_AUTORUN=
DRAWS_INTERVAL_MINUTES=

# Google Apps Script router that already serves BC PNP + OINP
# (the /exec URL you call with ?source=bcpnp and ?source=oinp).
# Without it, those two programs are simply skipped.
DRAWS_ROUTER_URL=

# Optional overrides. Alberta + OINP-Entrepreneur + Express Entry are fetched
# straight from the government sites by default. If your host cannot reach them
# (a run reports 403/timeout), route them through your Apps Script instead — it
# has a built-in proxy that returns each page verbatim:
#   DRAWS_ALBERTA_URL  = <your /exec>?secret=YOURSECRET&proxy=alberta
#   DRAWS_OINP_ENT_URL = <your /exec>?secret=YOURSECRET&proxy=oinp_ent
#   DRAWS_EE_URL       = <your /exec>?secret=YOURSECRET&proxy=ee
DRAWS_ALBERTA_URL=
DRAWS_OINP_ENT_URL=
DRAWS_EE_URL=

# Telegram chat id to ping when a channel starts failing (usually an expired
# LinkedIn/Instagram token). Leave blank to disable alerts. Use your own numeric
# user id — message @userinfobot on Telegram to find it.
DRAWS_ALERT_CHAT_ID=
# Days before an OINP Entrepreneur draw is considered too old to post (default 90).
DRAWS_OINP_ENT_STALE_DAYS=

# Post draws to a different Telegram channel than the script tool (optional —
# falls back to TELEGRAM_CHANNEL_ID above).
DRAWS_TELEGRAM_CHANNEL_ID=

# X / Twitter — OAuth 1.0a user context (these do NOT expire, unlike OAuth 2).
# From developer.x.com -> your app -> Keys and tokens. The access token must
# have Read *and* Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn — posts as an organization. LINKEDIN_ORG_ID is the numeric company
# id. The token needs w_organization_social and expires (~60 days), so it has
# to be refreshed periodically.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# Instagram — publishes the draw card as a Story. Needs a long-lived token for
# an Instagram professional account.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Seconds to wait between creating and publishing the story container (ms).
IG_PUBLISH_DELAY_MS=

# htmlcsstoimage.com — renders the story SVG to a public PNG, which Instagram
# requires (it will not accept inline image data). Without these, Instagram is
# skipped and the other three channels still post.
HCTI_USER_ID=
HCTI_API_KEY=

# WordPress draws page (optional) — the auto-updating Express Entry + 9-province
# page. Reuses WP_BASE_URL / WP_USER / WP_APP_PASSWORD above.
# DRAWS_UNIFIED_URL is the Apps Script endpoint returning { rounds, pnpDraws }.
# The WP user needs the `unfiltered_html` capability or the <style> is stripped.
DRAWS_UNIFIED_URL=
DRAWS_WP_PAGE_ID=
DRAWS_TIMEZONE=America/Vancouver

# Story card logo: base64 PNG (no "data:" prefix). Alternatively paste it into
# assets/story-logo.b64. Without it the card shows a text wordmark.
STORY_LOGO_B64=
