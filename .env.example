# ─────────────────────────────────────────────────────────────────────────────
# SUGIMOTO DRAWS — settings
# ─────────────────────────────────────────────────────────────────────────────
# Every channel is independent. Leave a block blank and that channel is simply
# skipped and reported as "Not set" — nothing breaks.
#
# Open the service's home page at any time to see which of these are still
# missing and what to do next.

# ── Required ────────────────────────────────────────────────────────────────
# Any long random string. Protects the endpoints; you pass it as ?key=<value>
# and the home page asks for it once.
DRAWS_CRON_SECRET=

# ── Scheduling ──────────────────────────────────────────────────────────────
# "true" makes the app run itself every DRAWS_INTERVAL_MINUTES (default 15),
# so there is no cron job to create. On a free Render instance the service
# sleeps when idle and the timer sleeps with it — keep an uptime pinger on
# /api/health, or point an external cron at /api/draws/run instead.
DRAWS_AUTORUN=true
DRAWS_INTERVAL_MINUTES=15

# ── Duplicate guard (required before anything can post) ─────────────────────
# Remembers which draws have already gone out, in a Google Sheet via an Apps
# Script web app. Publishing is refused without it, because in-process memory
# is wiped on every restart and that is what makes a draw repeat.
#
# Use a sheet of its own — see google-apps-script.gs, about 3 minutes to set up.
# Keeping it separate from the Topic Engine's sheet means tidying up one can
# never wipe the other's memory, and each run only downloads draw keys instead
# of every saved script and article.
#
# The Topic Engine's shared sheet also still works; the format is detected
# automatically, so switching is just changing these two values (then run
# /api/draws/run?key=…&seed=1 once so the current draws are not treated as new).
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# ── Where draw data comes from ──────────────────────────────────────────────
# Apps Script router serving ?source=bcpnp and ?source=oinp. Without it those
# two programs are skipped; Express Entry and Alberta still work.
DRAWS_ROUTER_URL=

# Express Entry, Alberta and OINP-Entrepreneur are read straight from the
# government sites. If this host cannot reach them (403 / timeout shows up in
# a run's sourceErrors), route them through the Apps Script proxy instead:
#   DRAWS_ALBERTA_URL  = <your /exec>?secret=YOURSECRET&proxy=alberta
#   DRAWS_OINP_ENT_URL = <your /exec>?secret=YOURSECRET&proxy=oinp_ent
#   DRAWS_EE_URL       = <your /exec>?secret=YOURSECRET&proxy=ee
DRAWS_ALBERTA_URL=
DRAWS_OINP_ENT_URL=
DRAWS_EE_URL=

# Days before a dormant OINP Entrepreneur draw is too old to post (default 90).
DRAWS_OINP_ENT_STALE_DAYS=

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. The bot must be an ADMIN of the target channel.
TELEGRAM_BOT_TOKEN=
# Where draws are posted. Use the test channel first, then switch to the real
# one. Accepts an @name or a numeric id.
DRAWS_TELEGRAM_CHANNEL_ID=@testchannel_draws

# Get a Telegram ping when a channel starts failing — usually an expired
# LinkedIn or Instagram token, which would otherwise fail silently. Your own
# numeric user id (message @userinfobot to find it).
DRAWS_ALERT_CHAT_ID=

# ── Instagram story ─────────────────────────────────────────────────────────
# Long-lived token for the Instagram professional account.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_PUBLISH_DELAY_MS=

# Instagram will not accept inline image data, so the story card is rendered to
# a hosted PNG first. Rendering runs in a real browser, which is what makes the
# Persian type and web font come out correctly. Without these, Instagram is
# skipped and the other channels still post.
HCTI_USER_ID=
HCTI_API_KEY=

# ── X ───────────────────────────────────────────────────────────────────────
# OAuth 1.0a. Unlike OAuth 2 these do not expire. developer.x.com → your app →
# Keys and tokens. The access token must have Read AND Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── LinkedIn ────────────────────────────────────────────────────────────────
# Posts as the organization. The token needs w_organization_social and expires
# roughly every 60 days.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# ── Website draws page (optional) ───────────────────────────────────────────
# Rewrites the Express Entry + 9-province page, but only when the draw data
# actually changed. The WordPress user needs the `unfiltered_html` capability
# or the page's <style> block is stripped out.
# DRAWS_UNIFIED_URL is the Apps Script endpoint returning { rounds, pnpDraws }.
DRAWS_UNIFIED_URL=
DRAWS_WP_PAGE_ID=
WP_BASE_URL=https://sugimotovisa.com
WP_USER=
WP_APP_PASSWORD=
DRAWS_TIMEZONE=America/Vancouver

# ── Story card logo (optional) ──────────────────────────────────────────────
# The logo already ships in assets/story-logo.b64. Set this only to override it
# with a different base64 PNG (no "data:" prefix).
STORY_LOGO_B64=
